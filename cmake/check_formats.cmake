#
# Checks that every requested plugin format was built for this platform.
#   cmake -DBIN=<build>/bin -DNAME=<name> -DTARGETS=lv2,vst3,... -DHAS_UI=1 -P check_formats.cmake

string(REPLACE "," ";" targets "${TARGETS}")
set(missing "")
set(found "")

if(APPLE)
  set(lib ".dylib")
elseif(WIN32)
  set(lib ".dll")
else()
  set(lib ".so")
endif()

macro(expect path what)
  if(EXISTS "${path}")
    list(APPEND found "${what}")
  else()
    string(APPEND missing "\n  ${what}: ${path}")
  endif()
endmacro()

foreach(t IN LISTS targets)
  if(t STREQUAL "lv2")
    set(b "${BIN}/${NAME}.lv2")
    expect("${b}/manifest.ttl" "LV2 manifest")
    expect("${b}/${NAME}_dsp.ttl" "LV2 plugin ttl")
    expect("${b}/${NAME}_dsp${lib}" "LV2 DSP binary")
    if(HAS_UI)
      expect("${b}/${NAME}_ui${lib}" "LV2 UI binary")
    endif()
  elseif(t STREQUAL "vst3")
    if(APPLE)
      expect("${BIN}/${NAME}.vst3/Contents/MacOS/${NAME}" "VST3")
    else()
      file(GLOB v "${BIN}/${NAME}.vst3/Contents/*/${NAME}.*")
      if(v)
        list(APPEND found "VST3")
      else()
        string(APPEND missing "\n  VST3: ${BIN}/${NAME}.vst3/Contents/<arch>/${NAME}.*")
      endif()
    endif()
  elseif(t STREQUAL "clap")
    if(APPLE)
      expect("${BIN}/${NAME}.clap/Contents/MacOS/${NAME}" "CLAP")
    else()
      expect("${BIN}/${NAME}.clap" "CLAP")
    endif()
  elseif(t STREQUAL "jack")
    if(APPLE)
      if(EXISTS "${BIN}/${NAME}.app")
        list(APPEND found "standalone")
      else()
        expect("${BIN}/${NAME}" "standalone")
      endif()
    elseif(WIN32)
      expect("${BIN}/${NAME}.exe" "standalone")
    else()
      expect("${BIN}/${NAME}" "standalone")
    endif()
  elseif(t STREQUAL "au")
    if(APPLE)
      expect("${BIN}/${NAME}.component/Contents/MacOS/${NAME}" "AU")
    endif()
  endif()
endforeach()

if(missing)
  message(FATAL_ERROR "${NAME}: formats not built:${missing}")
endif()
string(REPLACE ";" ", " found "${found}")
message(STATUS "${NAME}: built ${found}")
